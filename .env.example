# ================================================
# COPA 2026 — Variáveis de Ambiente
# ================================================
# Copie este arquivo para .env.local e preencha os valores
# NUNCA suba o .env.local para o git!

# --- SUPABASE ---
# Encontre em: supabase.com → seu projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --- STRIPE ---
# Encontre em: dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sua_chave_aqui
STRIPE_SECRET_KEY=sk_test_sua_chave_aqui
STRIPE_WEBHOOK_SECRET=whsec_sua_chave_aqui

# ID do produto Premium no Stripe (crie em Products → Add product)
STRIPE_PREMIUM_PRICE_ID=price_sua_id_aqui

# --- APP ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
